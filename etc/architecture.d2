direction: right

classes: {
  go_package: {
    shape: package
    style: {
      fill: "#41b94b"
      stroke: "#2e7d32"
    }
  }
  file: {
    style: {
      fill: "#fff3e0"
      stroke: "#ef6c00"
    }
  }
  component: {
    style: {
      fill: "#e3f2fd"
      stroke: "#1565c0"
      stroke-width: 2
    }
  }
}

User: {
  shape: person
  style: {
    fill: "#ffccbc"
  }
}

Sanvasify Server: {
  style: {
    fill: "#f5f5f5"
    stroke: "#616161"
    stroke-dash: 3
  }

  Main: {
    class: go_package
    label: cmd/server/main.go
  }

  HTTPServer: {
    class: component
    label: HTTP Server (net/http)

    Handlers: {
      label: pkg/server
      
      StaticFileHandler
      APIHandlers: {
        label: API Handlers
        SearchHandler
        NAVHandler
      }
    }
  }

  Logic: {
    class: component
    label: Core Logic

    NAVPackage: {
      class: go_package
      label: pkg/nav

      Store: {
        shape: cylinder
        label: In-Memory Store
        description: Maps for O(1) lookup
      }
      Parser: {
        label: Data Parser
      }
    }

    ConfigPackage: {
      class: go_package
      label: pkg/conf
    }
  }
}

FileSystem: {
  label: File System
  style: {
    fill: transparent
    stroke: transparent
  }

  ConfigFile: {
    class: file
    label: config/Config.toml
  }
  DataFile: {
    class: file
    label: Input Data File
  }
  StaticFiles: {
    class: file
    label: web/static/*
  }
}

# Relationships
User -> Sanvasify Server.HTTPServer: HTTP Requests (Browser)

Sanvasify Server.Main -> Sanvasify Server.Logic.ConfigPackage: Load Config
Sanvasify Server.Main -> Sanvasify Server.Logic.NAVPackage.Parser: Init Data
Sanvasify Server.Main -> Sanvasify Server.HTTPServer: Start

Sanvasify Server.Logic.ConfigPackage -> FileSystem.ConfigFile: Read
Sanvasify Server.Logic.NAVPackage.Parser -> FileSystem.DataFile: Read & Parse
Sanvasify Server.Logic.NAVPackage.Parser -> Sanvasify Server.Logic.NAVPackage.Store: Populate

Sanvasify Server.HTTPServer.Handlers.StaticFileHandler -> FileSystem.StaticFiles: Serve
Sanvasify Server.HTTPServer.Handlers.APIHandlers -> Sanvasify Server.Logic.NAVPackage.Store: Query