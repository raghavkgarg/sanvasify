# macOS system files
.DS_Store
dist/

# Database files
*.db
*.db-shm
*.db-wal

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically
*.out

# Local development and debug files
Debug.txt
scratch.txt

# Go build artifacts
# Use a leading slash to only match binaries in the project root
/sanvasify-server
/sanvasify

# Environment variables - never commit these
.env
.env.*
!/.env.example
