direction: right

user: User {
  shape: person
}

browser: Web Browser {
  html: HTML/CSS/JS
  charts: Chart.js
}

server: Go Server {
  api: API Handlers
  auth: Auth Module
  fetcher: AMFI Fetcher
}

db: DuckDB {
  shape: cylinder
  users: users table
  nav: NAV data
}

amfi: AMFI Website {
  shape: cloud
}

oauth: OAuth Providers {
  shape: cloud
  google: Google
  github: GitHub
}

# User flow
user -> browser: Access

# Browser to server
browser -> server.api: API requests
browser -> server.auth: Login

# Authentication
server.auth -> oauth: OAuth flow
server.auth -> browser: JWT cookie

# Data operations
server.api -> db.nav: Query
server.auth -> db.users: User data
server.fetcher -> amfi: Fetch reports
server.fetcher -> db.nav: Store Parquet

# Response
server.api -> browser: JSON
browser.charts -> browser.html: Render
